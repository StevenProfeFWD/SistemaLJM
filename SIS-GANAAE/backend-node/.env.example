# Configuración JWT
# IMPORTANTE (producción): genere valores aleatorios fuertes, p. ej. openssl rand -base64 48
# El servidor rechazará el arranque en NODE_ENV=production si usa los valores por defecto.
JWT_SECRET=clave-jwt
JWT_EXPIRES_IN=1h

# Clave para cifrado de cookies (mín. 16 caracteres; 32+ recomendado)
# IMPORTANTE (producción): use un valor aleatorio distinto de JWT_SECRET.
COOKIE_ENCRYPTION_KEY=clave-cifrado-cookies-32-chars-minimo

# Origen(es) del frontend para CORS (separados por coma si hay varios).
# Desarrollo: http://localhost:5173
# Producción: obligatorio (p. ej. https://matricula.liceomarti.ed.cr)
FRONTEND_ORIGIN=http://localhost:5173

# Hora local (0-23) para la limpieza diaria de jwt_revocado. Por defecto 3 (03:00).
# JWT_CLEANUP_HOUR=3


# Opcional: timeout en ms para API Hacienda (consulta cédula/DIMEX). Por defecto 10000. Rango 5000–120000.
# HACIENDA_TIMEOUT_MS=30000

# Correo SMTP (notificaciones a encargados legales)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tu-correo-institucional@liceo.ed.cr
SMTP_PASS=tu-contraseña-de-aplicacion-o-servicio
# Opcional: remitente visible (por defecto usa SMTP_USER)
# SMTP_FROM=notificaciones@liceomarti.ed.cr
